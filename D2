        .project-card .body .title:hover {
            color: var(--color-accent-2);
        }

        .project-card .body .caption {
            font-size: 0.85rem;
            color: var(--color-text-3);
            line-height: 1.6;
            margin-bottom: 14px;
            flex: 1;
        }

        .project-card .body .techs {
            display: flex;
            flex-wrap: wrap;
            gap: 4px;
            margin-bottom: 14px;
        }

        .project-card .body .techs span {
            padding: 2px 12px;
            background: var(--color-accent-dim);
            border-radius: 20px;
            font-size: 0.68rem;
            font-weight: 600;
            color: var(--color-accent-2);
        }

        .project-card .body .footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 14px;
            border-top: 1px solid var(--color-border);
        }

        .project-card .body .footer .link {
            color: var(--color-accent-2);
            text-decoration: none;
            font-family: var(--font-mono);
            font-size: 0.78rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all var(--duration-fast) var(--ease-out);
        }

        .project-card .body .footer .link:hover {
            color: #fff;
            transform: translateX(4px);
        }

        @media (max-width: 600px) {
            .projects-grid {
                grid-template-columns: 1fr;
            }
            .filter-btn {
                padding: 8px 16px;
                font-size: 0.7rem;
            }
        }

        /* ═══════════════════════════════════════════════════
           CERTIFICATIONS
           ═══════════════════════════════════════════════════ */
        .certs-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 24px;
        }

        .cert-card {
            background: var(--color-surface-glass);
            backdrop-filter: blur(12px);
            border: 1px solid var(--color-border);
            border-radius: 20px;
            overflow: hidden;
            box-shadow: var(--shadow-card);
            transition: all var(--duration-med) var(--ease-spring);
            cursor: pointer;
            display: flex;
            flex-direction: column;
        }

        .cert-card:hover {
            transform: translateY(-6px);
            border-color: var(--color-accent);
            box-shadow: var(--shadow-card-hover);
        }

        .cert-card .frame {
            position: relative;
            width: 100%;
            height: 170px;
            background: var(--color-surface-2);
            overflow: hidden;
        }

        .cert-card .frame img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.5s var(--ease-spring);
        }

        .cert-card:hover .frame img {
            transform: scale(1.05);
        }

        .cert-card .frame .overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(56, 132, 255, 0.75), transparent 65%);
            display: flex;
            align-items: flex-end;
            justify-content: center;
            padding-bottom: 16px;
            color: #fff;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            font-weight: 600;
            opacity: 0;
            transition: opacity var(--duration-fast) var(--ease-out);
        }

        .cert-card:hover .frame .overlay {
            opacity: 1;
        }

        .cert-card .info {
            padding: 16px 20px 20px;
        }

        .cert-card .info .issuer {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--color-accent-3);
        }

