        @media (max-width: 600px) {
            .glass-card {
                padding: 20px 18px;
            }
            .card-header {
                flex-wrap: wrap;
                gap: 8px;
            }
        }

        /* ═══════════════════════════════════════════════════
           DIAGNOSTICS CAROUSEL
           ═══════════════════════════════════════════════════ */
        .diag-container {
            background: var(--color-surface-glass);
            backdrop-filter: blur(16px);
            border: 1px solid var(--color-border);
            border-radius: 28px;
            padding: 28px 32px 32px;
            box-shadow: var(--shadow-float);
            max-width: 880px;
            margin: 0 auto;
        }

        .diag-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
            margin-bottom: 24px;
        }

        .diag-header .left .badge {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--color-accent-3);
        }

        .diag-header .left h3 {
            font-size: 1.3rem;
            font-weight: 800;
        }

        .diag-tabs {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .diag-tabs button {
            padding: 8px 18px;
            background: var(--color-surface-2);
            border: 1px solid var(--color-border);
            border-radius: 40px;
            font-family: var(--font-mono);
            font-size: 0.72rem;
            font-weight: 600;
            color: var(--color-text-3);
            cursor: pointer;
            transition: all var(--duration-fast) var(--ease-out);
        }

        .diag-tabs button:hover {
            color: #fff;
            border-color: var(--color-accent);
        }

        .diag-tabs button.active {
            background: var(--gradient-primary);
            color: #fff;
            border-color: transparent;
            box-shadow: 0 4px 20px rgba(56, 132, 255, 0.30);
        }

        .carousel-viewport {
            position: relative;
            overflow: hidden;
            border-radius: 20px;
            background: #080F1C;
            border: 1px solid var(--color-border);
        }

        .carousel-track {
            display: flex;
            transition: transform 0.5s cubic-bezier(0.25, 1, 0.5, 1);
            will-change: transform;
        }

        .carousel-slide {
            min-width: 100%;
            display: flex;
            flex-direction: column;
            background: #080F1C;
        }

        .carousel-slide .img-wrap {
            position: relative;
            width: 100%;
            aspect-ratio: 16 / 9;
            background: #080F1C;
            overflow: hidden;
        }

        .carousel-slide .img-wrap img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
        }

        .carousel-slide .caption {
            padding: 16px 24px 20px;
            background: #0A1428;
            border-top: 1px solid var(--color-border);
        }

        .carousel-slide .caption .meta {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--color-accent-2);
            text-transform: uppercase;
            letter-spacing: 1.5px;
        }

        .carousel-slide .caption .desc {
            font-size: 0.9rem;
            color: var(--color-text-2);
            line-height: 1.6;
            margin-top: 4px;
        }

        .carousel-dots {
            display: flex;
            justify-content: center;
            gap: 8px;
            margin-top: 20px;
        }

        .carousel-dots button {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--color-border);
            border: none;
            cursor: pointer;
            padding: 0;
            transition: all 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .carousel-dots button.active {
            background: var(--color-accent);
            width: 32px;
            border-radius: 20px;
            box-shadow: 0 2px 12px rgba(56, 132, 255, 0.30);
        }

        @media (max-width: 600px) {
            .diag-container {
                padding: 20px 16px;
            }
            .diag-header .left h3 {
                font-size: 1.05rem;
            }
            .carousel-slide .caption {
                padding: 12px 16px 16px;
            }
            .carousel-slide .caption .desc {
                font-size: 0.8rem;
            }
        }

        /* ═══════════════════════════════════════════════════
           SKILLS
           ═══════════════════════════════════════════════════ */
        .skills-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
            gap: 20px;
        }

        .skill-module {
            background: var(--color-surface-glass);
            backdrop-filter: blur(12px);
            border: 1px solid var(--color-border);
            border-radius: 20px;
            padding: 24px 22px 22px;
            box-shadow: var(--shadow-card);
            transition: all var(--duration-med) var(--ease-spring);
            display: flex;
            flex-direction: column;
        }

        .skill-module:hover {
            transform: translateY(-6px);
            border-color: var(--color-accent);
            box-shadow: var(--shadow-card-hover);
        }

        .skill-module .head {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 14px;
        }

        .skill-module .head .icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            background: var(--color-accent-dim);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--color-accent-2);
            font-size: 1.1rem;
            flex-shrink: 0;
            transition: all var(--duration-fast) var(--ease-out);
        }

        .skill-module:hover .head .icon {
            background: var(--gradient-primary);
            color: #fff;
        }

        .skill-module .head h4 {
            font-size: 1rem;
            font-weight: 700;
        }

        .skill-tags {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
            margin-top: auto;
        }

        .skill-tag {
            padding: 4px 14px 4px 12px;
            background: var(--color-surface-2);
            border: 1px solid var(--color-border);
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--color-text-2);
            transition: all var(--duration-fast) var(--ease-out);
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        .skill-tag:hover {
            border-color: var(--color-accent);
            color: #fff;
            background: var(--color-accent-dim);
        }

        /* ═══════════════════════════════════════════════════
           PROJECTS (Cleaned without #01 E1 numbers)
           ═══════════════════════════════════════════════════ */
        .filter-bar {
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 8px;
            margin-bottom: 32px;
        }

        .filter-btn {
            padding: 10px 24px;
            background: var(--color-surface-2);
            border: 1px solid var(--color-border);
            border-radius: 40px;
            font-family: var(--font-mono);
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--color-text-3);
            cursor: pointer;
            transition: all var(--duration-fast) var(--ease-out);
        }

        .filter-btn:hover {
            color: #fff;
            border-color: var(--color-accent);
        }

        .filter-btn.active {
            background: var(--gradient-primary);
            color: #fff;
            border-color: transparent;
            box-shadow: 0 4px 20px rgba(56, 132, 255, 0.25);
        }

        .projects-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 24px;
        }

        .project-card {
            background: var(--color-surface-glass);
            backdrop-filter: blur(12px);
            border: 1px solid var(--color-border);
            border-radius: 22px;
            overflow: hidden;
            box-shadow: var(--shadow-card);
            transition: all var(--duration-med) var(--ease-spring);
            display: flex;
            flex-direction: column;
        }

        .project-card:hover {
            transform: translateY(-8px);
            border-color: var(--color-accent);
            box-shadow: var(--shadow-card-hover);
        }

        /* ─── Project Card Meta Header ─── */
        .project-card .meta {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 12px 18px 8px;
        }

        .project-card .meta .project-domain-tag {
            font-family: var(--font-mono);
            font-size: 0.70rem;
            font-weight: 700;
            color: var(--color-accent-2);
            background: var(--color-accent-dim);
            border: 1px solid var(--color-border);
            padding: 3px 12px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            letter-spacing: 0.4px;
