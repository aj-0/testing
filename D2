
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ajay C · Embedded Systems Engineer</title>
    <meta name="description" content="Portfolio of Ajay C — B.E. ECE | Embedded Software Developer specializing in STM32, ARM Cortex-M, FreeRTOS, CAN Bus & TinyML." />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800;14..32,900&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <!-- Font Awesome 6 (Free) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        /* ═══════════════════════════════════════════════════
           CSS VARIABLES — Design System
           ═══════════════════════════════════════════════════ */
        :root {
            /* Core Colors */
            --color-bg: #050B14;
            --color-surface: #0C1628;
            --color-surface-2: #111F33;
            --color-surface-3: #1A2D47;
            --color-surface-glass: rgba(12, 22, 40, 0.72);
            --color-border: rgba(56, 132, 255, 0.12);
            --color-border-strong: rgba(56, 132, 255, 0.28);

            /* Accent */
            --color-accent: #3884FF;
            --color-accent-glow: rgba(56, 132, 255, 0.25);
            --color-accent-dim: rgba(56, 132, 255, 0.08);
            --color-accent-2: #00D4AA;
            --color-accent-2-glow: rgba(0, 212, 170, 0.25);
            --color-accent-3: #F5A623;
            --color-accent-3-glow: rgba(245, 166, 35, 0.25);

            /* Text */
            --color-text: #EBF0F8;
            --color-text-2: #B0C8E8;
            --color-text-3: #7A94B8;
            --color-text-4: #4A6A8A;

            /* Gradients */
            --gradient-primary: linear-gradient(135deg, #3884FF 0%, #00D4AA 100%);
            --gradient-card: linear-gradient(145deg, rgba(12, 22, 40, 0.85), rgba(26, 45, 55, 0.60));
            --gradient-hero: radial-gradient(ellipse at 30% 40%, rgba(56, 132, 255, 0.12) 0%, transparent 70%);

            /* Shadows */
            --shadow-card: 0 8px 32px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(56, 132, 255, 0.06);
            --shadow-card-hover: 0 16px 48px rgba(0, 0, 0, 0.60), 0 0 0 1px rgba(56, 132, 255, 0.18);
            --shadow-float: 0 24px 64px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(56, 132, 255, 0.08);
            --shadow-glow: 0 0 40px rgba(56, 132, 255, 0.15);

            /* Typography */
            --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            --font-mono: 'JetBrains Mono', 'SF Mono', Consolas, monospace;

            /* Transitions */
            --ease-out: cubic-bezier(0.22, 1, 0.36, 1);
            --ease-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
            --duration-fast: 0.18s;
            --duration-med: 0.40s;
            --duration-slow: 0.65s;
        }

        /* ─── Reset & Base ─── */
        *,
        *::before,
        *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            transition: background-color var(--duration-med) var(--ease-out),
                        border-color var(--duration-med) var(--ease-out),
                        color var(--duration-med) var(--ease-out);
        }

        html {
            scroll-behavior: smooth;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        body {
            font-family: var(--font-sans);
            background: var(--color-bg);
            color: var(--color-text);
            line-height: 1.6;
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* ─── Background Canvas ─── */
        #bgCanvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            z-index: 0;
            pointer-events: none;
            opacity: 0.5;
        }

        .grid-overlay {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            background-image:
                linear-gradient(rgba(56, 132, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(56, 132, 255, 0.03) 1px, transparent 1px);
            background-size: 56px 56px;
        }

        /* ─── Container ─── */
        .app {
            position: relative;
            z-index: 1;
            max-width: 1320px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* ═══════════════════════════════════════════════════
           NAVIGATION
           ═══════════════════════════════════════════════════ */
        .nav-wrapper {
            position: fixed;
            top: 18px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 999;
            width: calc(100% - 48px);
            max-width: 1200px;
            pointer-events: none;
            padding: 0 12px;
        }

        .nav-bar {
            pointer-events: auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            padding: 10px 20px 10px 24px;
            background: var(--color-surface-glass);
            backdrop-filter: blur(24px) saturate(180%);
            -webkit-backdrop-filter: blur(24px) saturate(180%);
            border: 1px solid var(--color-border);
            border-radius: 80px;
            box-shadow: var(--shadow-float);
            transition: border-color var(--duration-med) var(--ease-out), box-shadow var(--duration-med) var(--ease-out);
        }

        .nav-bar:hover {
            border-color: var(--color-accent);
            box-shadow: var(--shadow-float), var(--shadow-glow);
        }

        .nav-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
            cursor: pointer;
            flex-shrink: 0;
        }

        .brand-icon {
            width: 38px;
            height: 38px;
            border-radius: 10px;
            background: var(--gradient-primary);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 1.1rem;
            box-shadow: 0 4px 16px rgba(56, 132, 255, 0.30);
            flex-shrink: 0;
        }

        .brand-text {
            display: flex;
            flex-direction: column;
            line-height: 1.2;
        }

        .brand-name {
            font-size: 1.05rem;
            font-weight: 800;
            letter-spacing: -0.3px;
            color: var(--color-text);
        }

        .brand-tag {
            font-family: var(--font-mono);
            font-size: 0.60rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            color: var(--color-accent-2);
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 4px;
            list-style: none;
        }

        .nav-links a {
            color: var(--color-text-2);
            text-decoration: none;
            font-size: 0.82rem;
            font-weight: 600;
            padding: 8px 14px;
            border-radius: 40px;
            transition: all var(--duration-fast) var(--ease-out);
            display: inline-flex;
            align-items: center;
            gap: 6px;
            cursor: pointer;
        }

        .nav-links a:hover,
        .nav-links a.active {
            color: #fff;
            background: var(--color-accent-dim);
        }

        .nav-links a i {
            font-size: 0.8rem;
            opacity: 0.6;
        }

        .nav-actions {
            display: flex;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        /* ─── HIGHLIGHT & ANIMATION FOR THEME SWITCHER ─── */
        .theme-btn {
            position: relative;
            background: var(--color-surface-2);
            border: 1px solid var(--color-border);
            color: var(--color-accent-3);
            font-size: 1.05rem;
            cursor: pointer;
            padding: 8px 14px;
            border-radius: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            animation: theme-glow 3.5s ease-in-out infinite;
            box-shadow: 0 0 12px var(--color-accent-3-glow);
        }

        .theme-btn:hover {
            color: #fff;
            background: var(--color-accent-dim);
            border-color: var(--color-accent-3);
            box-shadow: 0 0 20px rgba(245, 166, 35, 0.45);
            transform: scale(1.06);
        }

        .theme-btn i {
            display: inline-block;
            transition: transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        .theme-btn.rotate-anim i {
            transform: rotate(360deg) scale(1.3);
        }

        @keyframes theme-glow {
            0%, 100% {
                border-color: var(--color-border);
                box-shadow: 0 0 10px rgba(245, 166, 35, 0.15);
            }
            50% {
                border-color: rgba(245, 166, 35, 0.6);
                box-shadow: 0 0 22px rgba(245, 166, 35, 0.4);
            }
        }

        .menu-toggle {
            display: none;
            background: none;
            border: none;
            color: var(--color-text);
            font-size: 1.2rem;
            cursor: pointer;
            padding: 6px 8px;
            border-radius: 40px;
        }

        /* ─── Responsive Nav ─── */
        @media (max-width: 1024px) {
            .nav-links {
                display: none;
                position: absolute;
                top: calc(100% + 12px);
                left: 12px;
                right: 12px;
                background: var(--color-surface-glass);
                backdrop-filter: blur(28px) saturate(180%);
                -webkit-backdrop-filter: blur(28px) saturate(180%);
                border: 1px solid var(--color-border);
                border-radius: 20px;
                flex-direction: column;
                padding: 16px 8px;
                gap: 2px;
                box-shadow: var(--shadow-float);
            }
            .nav-links.open {
                display: flex;
            }
            .nav-links a {
                padding: 12px 16px;
                width: 100%;
                border-radius: 12px;
            }
            .menu-toggle {
                display: block;
            }
        }

        @media (max-width: 600px) {
            .nav-wrapper {
                top: 12px;
                width: calc(100% - 24px);
                padding: 0;
            }
            .nav-bar {
                padding: 8px 14px 8px 18px;
                border-radius: 60px;
            }
            .brand-name {
                font-size: 0.9rem;
            }
            .brand-tag {
                font-size: 0.5rem;
            }
            .brand-icon {
                width: 32px;
                height: 32px;
                font-size: 0.9rem;
            }
        }

        /* ═══════════════════════════════════════════════════
           SECTION HEADERS
           ═══════════════════════════════════════════════════ */
        section {
            padding: 80px 0 40px;
            position: relative;
        }

        .section-header {
            text-align: center;
            max-width: 720px;
            margin: 0 auto 48px;
        }

        .section-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 18px 6px 14px;
            background: var(--color-accent-dim);
            border: 1px solid var(--color-border);
            border-radius: 40px;
            font-family: var(--font-mono);
            font-size: 0.70rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.8px;
            color: var(--color-accent-2);
            margin-bottom: 16px;
        }

        .section-badge i {
            color: var(--color-accent-3);
        }

        .section-title {
            font-size: clamp(2rem, 3.8vw, 3rem);
            font-weight: 800;
            letter-spacing: -1.2px;
            line-height: 1.15;
            color: var(--color-text);
            margin-bottom: 12px;
        }

        .section-title span {
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .section-sub {
            font-size: 1.02rem;
            color: var(--color-text-3);
            line-height: 1.7;
        }

        /* ═══════════════════════════════════════════════════
           HERO
           ═══════════════════════════════════════════════════ */
        .hero {
            min-height: 88vh;
            display: flex;
            align-items: center;
            padding: 100px 0 40px;
            position: relative;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: -20%;
            right: -10%;
            width: 60%;
            height: 80%;
            background: var(--gradient-hero);
            border-radius: 50%;
            filter: blur(80px);
            pointer-events: none;
            z-index: 0;
        }

        .hero-grid {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 56px;
            align-items: center;
            width: 100%;
            position: relative;
            z-index: 1;
        }

        .hero-content {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
        }

        .hero-status {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 8px 20px 8px 16px;
            background: var(--color-surface-glass);
            backdrop-filter: blur(12px);
            border: 1px solid var(--color-border);
            border-radius: 40px;
            font-family: var(--font-mono);
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--color-accent-2);
            margin-bottom: 24px;
        }

        .hero-status .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--color-accent-2);
            box-shadow: 0 0 16px var(--color-accent-2-glow);
            animation: pulse-dot 2s ease-in-out infinite;
        }

        @keyframes pulse-dot {
            0%,
            100% {
                opacity: 1;
                transform: scale(1);
            }
            50% {
                opacity: 0.5;
                transform: scale(0.8);
            }
        }

        .hero-headline {
            font-size: clamp(2.4rem, 5.2vw, 4.2rem);
            font-weight: 900;
            letter-spacing: -2px;
            line-height: 1.08;
            color: var(--color-text);
            margin-bottom: 16px;
        }

        .hero-headline .highlight {
            background: var(--gradient-primary);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-tagline {
            font-size: 1.15rem;
            font-weight: 600;
            color: var(--color-accent-3);
            font-family: var(--font-mono);
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 12px;
        }

        .hero-tagline i {
            color: var(--color-accent-2);
        }

        .hero-desc {
            font-size: 1.05rem;
            color: var(--color-text-3);
            line-height: 1.8;
            max-width: 540px;
            margin-bottom: 32px;
        }

        .hero-actions {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 14px;
        }

        .btn-primary {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 32px;
            background: var(--gradient-primary);
            color: #fff;
            font-weight: 700;
            font-size: 0.92rem;
            border: none;
            border-radius: 60px;
            cursor: pointer;
            text-decoration: none;
            box-shadow: 0 8px 28px rgba(56, 132, 255, 0.30);
            transition: all var(--duration-med) var(--ease-spring);
        }

        .btn-primary:hover {
            transform: translateY(-3px) scale(1.02);
            box-shadow: 0 16px 40px rgba(56, 132, 255, 0.45);
        }

        .btn-secondary {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 14px 28px;
            background: var(--color-surface-glass);
            backdrop-filter: blur(12px);
            border: 1px solid var(--color-border);
            border-radius: 60px;
            color: var(--color-text-2);
            font-weight: 600;
            font-size: 0.92rem;
            cursor: pointer;
            text-decoration: none;
            transition: all var(--duration-fast) var(--ease-out);
        }

        .btn-secondary:hover {
            border-color: var(--color-accent);
            color: #fff;
            background: var(--color-accent-dim);
            transform: translateY(-2px);
        }

        /* ─── HIGHLIGHT & ANIMATION FOR RESUME DOWNLOAD ─── */
        .btn-resume {
            position: relative;
            overflow: hidden;
            border: 1px solid var(--color-accent-2);
            color: var(--color-text);
            background: rgba(0, 212, 170, 0.08);
            box-shadow: 0 0 18px var(--color-accent-2-glow);
            animation: resume-pulse 3s ease-in-out infinite;
            display: inline-flex;
            align-items: center;
            gap: 9px;
            font-weight: 700;
            padding: 14px 26px;
            border-radius: 60px;
            text-decoration: none;
            cursor: pointer;
        }

        .btn-resume:hover {
            background: rgba(0, 212, 170, 0.18);
            border-color: var(--color-accent-2);
            color: #fff;
            box-shadow: 0 0 30px rgba(0, 212, 170, 0.5);
            transform: translateY(-3px) scale(1.02);
        }

        .btn-resume .resume-icon {
            color: var(--color-accent-2);
            font-size: 1rem;
            animation: icon-bounce 2s ease-in-out infinite;
        }

        .btn-resume .resume-badge {
            font-family: var(--font-mono);
            font-size: 0.65rem;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 12px;
            background: rgba(0, 212, 170, 0.22);
            color: var(--color-accent-2);
            letter-spacing: 0.5px;
        }

        /* Shimmer sweep animation */
        .btn-resume::after {
            content: '';
            position: absolute;
            top: -60%;
            left: -80%;
            width: 45%;
            height: 220%;
            background: linear-gradient(
                to right,
                transparent,
                rgba(255, 255, 255, 0.22),
                transparent
            );
            transform: rotate(25deg);
            animation: resume-shimmer 4s ease-in-out infinite;
            pointer-events: none;
        }

        @keyframes resume-pulse {
            0%, 100% {
                box-shadow: 0 4px 16px rgba(0, 212, 170, 0.2);
                border-color: rgba(0, 212, 170, 0.35);
            }
            50% {
                box-shadow: 0 4px 28px rgba(0, 212, 170, 0.55);
                border-color: rgba(0, 212, 170, 0.85);
            }
        }

        @keyframes resume-shimmer {
            0% {
                left: -80%;
            }
            30%, 100% {
                left: 180%;
            }
        }

        @keyframes icon-bounce {
            0%, 100% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(3px);
            }
        }

        /* ─── Hero Visual ─── */
        .hero-visual {
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 380px;
        }

        .orbital-ring {
            position: relative;
            width: 360px;
            height: 360px;
            display: flex;
            justify-content: center;
            align-items: center;
            animation: float-orbit 10s ease-in-out infinite alternate;
        }

        @keyframes float-orbit {
            0% {
                transform: translateY(0) rotateX(6deg) rotateY(-8deg);
            }
            100% {
                transform: translateY(-18px) rotateX(10deg) rotateY(-4deg);
            }
        }

        .ring {
            position: absolute;
            border-radius: 50%;
            border: 1.5px solid transparent;
            box-sizing: border-box;
        }

        .ring-1 {
            width: 100%;
            height: 100%;
            border-top: 2px solid var(--color-accent);
            border-bottom: 2px solid var(--color-accent-2);
            animation: spin-ring 14s linear infinite;
            box-shadow: 0 0 30px rgba(56, 132, 255, 0.08);
        }

        .ring-2 {
            width: 76%;
            height: 76%;
            border-left: 2px solid var(--color-accent-3);
            border-right: 2px solid var(--color-accent-2);
            animation: spin-ring 10s linear infinite reverse;
        }

        .ring-3 {
            width: 54%;
            height: 54%;
            border: 1px dashed rgba(56, 132, 255, 0.25);
            animation: spin-ring 20s linear infinite;
        }

        @keyframes spin-ring {
            0% {
                transform: rotate(0deg) rotateX(55deg);
            }
            100% {
                transform: rotate(360deg) rotateX(55deg);
            }
        }

        .chip-core {
            position: relative;
            z-index: 10;
            width: 130px;
            height: 130px;
            background: radial-gradient(circle at 20% 25%, #162A4A, #0A1428);
            border-radius: 16px;
            border: 2px solid var(--color-accent);
            box-shadow: 0 0 50px rgba(56, 132, 255, 0.25), inset 0 0 30px rgba(56, 132, 255, 0.08);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transform: translateZ(20px);
        }

        .chip-core::before {
            content: '';
            position: absolute;
            inset: -12px 16px;
            background: repeating-linear-gradient(to right, transparent, transparent 8px, var(--color-accent-3) 8px, var(--color-accent-3) 10px);
            z-index: -1;
            border-radius: 4px;
        }

        .chip-core::after {
            content: '';
            position: absolute;
            inset: 16px -12px;
            background: repeating-linear-gradient(to bottom, transparent, transparent 8px, var(--color-accent-3) 8px, var(--color-accent-3) 10px);
            z-index: -1;
            border-radius: 4px;
        }

        .chip-inner {
            text-align: center;
            width: 100%;
            height: 100%;
            border-radius: 14px;
            background: radial-gradient(circle at 30% 30%, #1A2D47, #0A1428);
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .chip-inner::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 40%;
            height: 100%;
            background: linear-gradient(to right, transparent, rgba(255, 255, 255, 0.06), transparent);
            transform: skewX(-25deg);
            animation: scan-chip 5s infinite;
        }

        @keyframes scan-chip {
            0%,
            60% {
                left: -100%;
            }
            100% {
                left: 200%;
            }
        }

        .chip-logo {
            font-family: var(--font-mono);
            font-weight: 900;
            font-size: 1.8rem;
            color: var(--color-accent-2);
            letter-spacing: 3px;
            text-shadow: 0 0 20px rgba(0, 212, 170, 0.30);
        }

        .chip-model {
            font-family: var(--font-mono);
            font-size: 0.75rem;
            font-weight: 700;
            color: var(--color-text-2);
            letter-spacing: 1px;
        }

        .orbit-tag {
            position: absolute;
            background: var(--color-surface-glass);
            backdrop-filter: blur(16px);
            border: 1px solid var(--color-border);
            border-radius: 40px;
            padding: 6px 14px 6px 12px;
            font-family: var(--font-mono);
            font-size: 0.68rem;
            font-weight: 600;
            color: var(--color-text-2);
            box-shadow: var(--shadow-card);
            display: flex;
            align-items: center;
            gap: 6px;
            z-index: 20;
            transition: all var(--duration-med) var(--ease-spring);
            white-space: nowrap;
        }

        .orbit-tag:hover {
            transform: scale(1.10) translateY(-4px);
            border-color: var(--color-accent);
            box-shadow: var(--shadow-glow);
        }

        .orbit-tag i {
            color: var(--color-accent-2);
        }

        .tag-1 {
            top: 2%;
            left: -8%;
            animation: float-tag-1 7s ease-in-out infinite alternate;
        }
        .tag-2 {
            top: -2%;
            right: -10%;
            animation: float-tag-2 8s ease-in-out infinite alternate;
        }
        .tag-3 {
            bottom: 10%;
            left: -14%;
            animation: float-tag-3 6.5s ease-in-out infinite alternate;
        }
        .tag-4 {
            bottom: 4%;
            right: -12%;
            animation: float-tag-1 9s ease-in-out infinite alternate;
        }
        .tag-5 {
            top: 42%;
            right: -28%;
            animation: float-tag-2 7.5s ease-in-out infinite alternate;
        }

        @keyframes float-tag-1 {
            0% {
                transform: translateY(0);
            }
            100% {
                transform: translateY(-10px);
            }
        }
        @keyframes float-tag-2 {
            0% {
                transform: translateY(0);
            }
            100% {
                transform: translateY(12px);
            }
        }
        @keyframes float-tag-3 {
            0% {
                transform: translateY(0);
            }
            100% {
                transform: translateY(-6px);
            }
        }

