            box-shadow: var(--shadow-card-hover);
        }

        .card-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 20px;
            padding-bottom: 16px;
            border-bottom: 1px solid var(--color-border);
        }

        .card-header .left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .card-header .left i {
            color: var(--color-accent-2);
            font-size: 1.2rem;
        }

        .card-header .left h3 {
            font-size: 1.2rem;
            font-weight: 700;
        }

        .card-header .badge {
