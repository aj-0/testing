        /* ═══════════════════════════════════════════════════
           QUICK HUB
           ═══════════════════════════════════════════════════ */
        .quick-hub {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
            gap: 16px;
            margin: 8px 0 48px;
        }

        .hub-tile {
