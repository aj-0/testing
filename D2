                    document.documentElement.style.setProperty('--color-text-2', '#B0C8E8');
                    document.documentElement.style.setProperty('--color-text-3', '#7A94B8');
                    document.documentElement.style.setProperty('--color-text-4', '#4A6A8A');
                    document.documentElement.style.setProperty('--color-border', 'rgba(56,132,255,0.12)');
                    document.documentElement.style.setProperty('--color-border-strong', 'rgba(56,132,255,0.28)');
                    icon.classList.replace('fa-sun', 'fa-moon');
                }
            }

            const initialLight = stored === 'light' || (!stored && !prefersDark);
            applyTheme(initialLight);

            btn.addEventListener('click', () => {
                // Trigger button spin animation
                btn.classList.add('rotate-anim');
                setTimeout(() => btn.classList.remove('rotate-anim'), 500);

                const isDark = document.documentElement.style.getPropertyValue('--color-bg').trim() === '#F0F5FC';
                if (isDark) {
                    applyTheme(false);
                    localStorage.setItem('theme', 'dark');
                } else {
                    applyTheme(true);
                    localStorage.setItem('theme', 'light');
                }
            });
        })();

