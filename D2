    <script>
        // ──────────────────────────────────────────────
        // 1. BACKGROUND ENGINE — Isometric 3D Network
        // ──────────────────────────────────────────────
        (function bgEngine() {
            const canvas = document.getElementById('bgCanvas');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            let w, h, traces = [],
                signals = [],
                time = 0;

            function resize() {
                w = canvas.width = window.innerWidth;
                h = canvas.height = window.innerHeight;
                generate();
            }

            function generate() {
                traces = [];
                signals = [];
                const count = Math.floor(Math.min(w, h) / 28);
                for (let i = 0; i < count; i++) {
                    let cx = (Math.random() - 0.5) * 280;
                    let cy = (Math.random() - 0.5) * 280;
                    let path = [{ x: cx, y: cy }];
                    for (let j = 0; j < 4; j++) {
                        const len = 80 + Math.random() * 280;
                        if (Math.random() > 0.5) cx += (Math.random() > 0.5 ? 1 : -1) * len;
                        else cy += (Math.random() > 0.5 ? 1 : -1) * len;
                        path.push({ x: cx, y: cy });
                    }
                    const color = Math.random() > 0.5 ?
                        'rgba(56,132,255,0.18)' :
                        'rgba(0,212,170,0.14)';
                    traces.push({ path, color });
                    for (let k = 0; k < 2; k++) {
                        signals.push({
                            traceIdx: i,
                            progress: Math.random(),
                            speed: 0.0015 + Math.random() * 0.003,
                            color: Math.random() > 0.5 ? '#3884FF' : '#00D4AA'
                        });
                    }
                }
            }

            function getPoint(path, progress) {
                const segs = path.length - 1;
                const scaled = progress * segs;
                const idx = Math.min(Math.floor(scaled), segs - 1);
                const t = scaled - idx;
                const p1 = path[idx],
                    p2 = path[idx + 1];
                return { x: p1.x + (p2.x - p1.x) * t, y: p1.y + (p2.y - p1.y) * t };
            }

            function loop() {
                ctx.clearRect(0, 0, w, h);
                time += 0.008;
                ctx.save();
                ctx.translate(w / 2, h / 2);
                ctx.scale(1, 0.5);
                ctx.rotate(Math.PI / 4);

                traces.forEach(tr => {
                    ctx.strokeStyle = tr.color;
                    ctx.lineWidth = 1.8;
                    ctx.beginPath();
                    tr.path.forEach((p, i) => {
                        if (i === 0) ctx.moveTo(p.x, p.y);
                        else ctx.lineTo(p.x, p.y);
                    });
                    ctx.stroke();
                });

                signals.forEach(sig => {
                    sig.progress += sig.speed;
                    if (sig.progress > 1) sig.progress = 0;
                    const tr = traces[sig.traceIdx];
                    if (!tr) return;
                    const pos = getPoint(tr.path, sig.progress);
                    ctx.beginPath();
                    ctx.arc(pos.x, pos.y, 4, 0, Math.PI * 2);
                    ctx.fillStyle = sig.color;
                    ctx.shadowColor = sig.color;
                    ctx.shadowBlur = 16;
                    ctx.fill();
                    ctx.shadowBlur = 0;
                });

                // 3D chip silhouette at center
                const size = 80;
                const thick = 16;
                for (let i = 0; i < thick; i++) {
                    ctx.translate(-1, -1);
                    ctx.fillStyle = i === thick - 1 ? '#0A1428' : '#111F33';
                    ctx.strokeStyle = i === thick - 1 ? 'rgba(56,132,255,0.30)' : 'transparent';
                    ctx.lineWidth = 1.5;
                    ctx.fillRect(-size / 2, -size / 2, size, size);
                    if (i === thick - 1) ctx.strokeRect(-size / 2, -size / 2, size, size);
                }

                ctx.restore();
                requestAnimationFrame(loop);
            }

            window.addEventListener('resize', resize);
            resize();
            loop();
        })();

