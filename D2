            .quick-hub {
                grid-template-columns: repeat(2, 1fr);
                gap: 12px;
            }
            .hub-tile {
                padding: 16px 14px;
            }
            .hub-tile .desc {
                font-size: 0.7rem;
            }
        }

        /* ═══════════════════════════════════════════════════
           ABOUT
           ═══════════════════════════════════════════════════ */
        .about-grid {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 28px;
        }

        .glass-card {
            background: var(--color-surface-glass);
            backdrop-filter: blur(16px);
            border: 1px solid var(--color-border);
