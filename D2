        .mindset-box ul {
            list-style: none;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .mindset-box ul li {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-size: 0.88rem;
            color: var(--color-text-2);
            line-height: 1.5;
        }

        .mindset-box ul li i {
            color: var(--color-accent-2);
            margin-top: 3px;
            font-size: 0.75rem;
        }

        .pipeline-box {
            background: #070E1A;
            border-radius: 12px;
            padding: 16px 20px;
            margin-top: 16px;
            font-family: var(--font-mono);
            font-size: 0.78rem;
            line-height: 1.7;
            border: 1px solid var(--color-border);
            color: var(--color-text-2);
        }

        .pipeline-box .tag {
            color: var(--color-accent-2);
            font-weight: 700;
        }

        /* ─── Specs ─── */
        .spec-list {
            display: flex;
            flex-direction: column;
            gap: 14px;
        }

        .spec-item {
            background: var(--color-surface-2);
            border: 1px solid var(--color-border);
            border-radius: 14px;
            padding: 16px 18px;
            transition: all var(--duration-fast) var(--ease-out);
        }

        .spec-item:hover {
            border-color: var(--color-accent);
        }

        .spec-item .label {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--color-accent-2);
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 6px;
        }

        .spec-item .value {
            font-size: 0.92rem;
            color: var(--color-text-2);
            line-height: 1.7;
        }

        .spec-item .value strong {
            color: var(--color-text);
        }

        .spec-item .value a {
            color: var(--color-accent-2);
            text-decoration: none;
            font-weight: 600;
        }

        .gauge-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            font-size: 0.88rem;
        }

        .gauge-track {
            width: 100%;
            height: 6px;
            background: var(--color-surface-3);
            border-radius: 20px;
            overflow: hidden;
            margin-top: 6px;
            margin-bottom: 8px;
        }

        .gauge-fill {
            height: 100%;
            background: var(--gradient-primary);
            border-radius: 20px;
        }

        @media (max-width: 1024px) {
            .about-grid {
                grid-template-columns: 1fr;
            }
