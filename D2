        // 5a. Diagnostics Carousel
        (function diag() {
            const track = document.getElementById('diagTrack');
            const dots = document.getElementById('diagDots');
            const tabs = document.getElementById('diagTabs');
            if (!track) return;
            let current = 0;
            const total = debugData.length;
            let autoplay;

            track.innerHTML = debugData.map(item => `
                <div class="carousel-slide">
                    <div class="img-wrap"><img src="${item.img}" alt="${item.meta}" loading="lazy" /></div>
                    <div class="caption">
                        <div class="meta">${item.meta}</div>
                        <div class="desc">${item.desc}</div>
                    </div>
                </div>
            `).join('');

            dots.innerHTML = debugData.map((_, i) =>
                `<button class="${i===0?'active':''}" data-idx="${i}"></button>`
            ).join('');

            tabs.innerHTML = debugData.map((item, i) =>
                `<button class="${i===0?'active':''}" data-idx="${i}">${item.meta.split(' ')[0]}</button>`
            ).join('');

            function goTo(idx) {
                current = (idx + total) % total;
                track.style.transform = `translateX(-${current*100}%)`;
                document.querySelectorAll('#diagDots button').forEach((b, i) => b.classList.toggle('active', i === current));
                document.querySelectorAll('#diagTabs button').forEach((b, i) => b.classList.toggle('active', i === current));
            }

            function next() { goTo(current + 1); }

            function startAuto() { if (autoplay) clearInterval(autoplay);
                autoplay = setInterval(next, 2800); }

            function stopAuto() { if (autoplay) clearInterval(autoplay);
                autoplay = null; }

            document.querySelectorAll('#diagDots button, #diagTabs button').forEach(el => {
                el.addEventListener('click', () => {
                    const idx = parseInt(el.dataset.idx);
                    if (!isNaN(idx)) { goTo(idx);
                        stopAuto();
                        startAuto(); }
                });
            });

            const viewport = track.closest('.carousel-viewport');
            if (viewport) {
                viewport.addEventListener('mouseenter', stopAuto);
                viewport.addEventListener('mouseleave', startAuto);
            }

            startAuto();
            window.diagGo = goTo;
        })();

        // 5b. Skills
        (function renderSkills() {
            const grid = document.getElementById('skillsGrid');
            if (!grid) return;
            grid.innerHTML = skillsData.map(s => `
                <div class="skill-module">
                    <div class="head">
                        <div class="icon"><i class="fas ${s.icon}"></i></div>
                        <h4>${s.title}</h4>
                    </div>
                    <div class="skill-tags">
                        ${s.tags.map(t => `<span class="skill-tag">${t}</span>`).join('')}
                    </div>
                </div>
            `).join('');
        })();

        // 5c. Projects (Cleaned without #01 E1 numbers)
        const catLabels = { embedded: 'Bare Metal', freertos: 'FreeRTOS', ai: 'Tiny ML', pcb: 'PCB Design' };
        let currentFilter = 'all';

        function renderProjects(filter) {
            const grid = document.getElementById('projectsGrid');
            if (!grid) return;
            const keys = filter === 'all' ? Object.keys(projectsData) : [filter];
            let html = '';
            keys.forEach(cat => {
                if (projectsData[cat]) {
                    projectsData[cat].forEach(p => {
                        const badge = catLabels[cat] || cat.toUpperCase();
                        html += `
                            <div class="project-card" data-cat="${cat}">
                                <div class="meta">
                                    <span class="project-domain-tag"><i class="fas fa-layer-group"></i> ${p.domain || badge}</span>
                                </div>
                                <div class="media" onclick="window.open('${p.url}','_blank','noopener')">
                                    <img src="${p.img}" alt="${p.title}" loading="lazy" onerror="this.style.display='none'" />
                                </div>
                                <div class="body">
                                    <div class="title" onclick="window.open('${p.url}','_blank','noopener')">${p.title}</div>
                                    <div class="caption">${p.caption}</div>
                                    <div class="techs">${p.tech.map(t => `<span>${t}</span>`).join('')}</div>
                                    <div class="footer">
                                        <a class="link" href="${p.url}" target="_blank" rel="noopener"><i class="fab fa-github"></i> Inspect Project →</a>
                                    </div>
                                </div>
                            </div>
                        `;
                    });
                }
            });
            grid.innerHTML = html || '<p style="grid-column:1/-1;text-align:center;color:var(--color-text-3);padding:2rem;">No projects in this category.</p>';
        }

        function initFilters() {
            const bar = document.getElementById('filterBar');
            if (!bar) return;
            const filters = ['all', 'embedded', 'freertos', 'ai', 'pcb'];
            const labels = { all: 'All Modules', embedded: 'Bare Metal', freertos: 'FreeRTOS', ai: 'Tiny ML', pcb: 'PCB Design' };
            bar.innerHTML = filters.map(f =>
                `<button class="filter-btn ${f==='all'?'active':''}" data-filter="${f}">${labels[f]||f}</button>`
            ).join('');
            bar.addEventListener('click', e => {
                const btn = e.target.closest('.filter-btn');
                if (!btn) return;
                document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                currentFilter = btn.dataset.filter;
                renderProjects(currentFilter);
            });
        }

        // 5d. Certifications
        function renderCerts() {
            const grid = document.getElementById('certsGrid');
            if (!grid) return;
            grid.innerHTML = certsData.map((c, i) => `
                <div class="cert-card" onclick="openLightbox(${i})">
                    <div class="frame">
                        <img src="${c.img}" alt="${c.name}" loading="lazy" onerror="this.style.display='none'" />
                        <div class="overlay"><span><i class="fas fa-search-plus"></i> Inspect Certificate</span></div>
                    </div>
                    <div class="info">
                        <div class="issuer">${c.issuer}</div>
                        <div class="name">${c.name}</div>
                    </div>
                </div>
            `).join('');
        }

        function openLightbox(idx) {
            const modal = document.getElementById('certLightbox');
            const img = document.getElementById('lightboxImg');
            if (!modal || !img) return;
            img.src = certsData[idx].img;
            img.alt = certsData[idx].name;
            modal.classList.add('open');
        }

        function closeLightbox() {
            document.getElementById('certLightbox')?.classList.remove('open');
        }
        window.openLightbox = openLightbox;
        window.closeLightbox = closeLightbox;

        // 5e. Resources
        function renderResources() {
            const box = document.getElementById('resourcesBox');
            if (!box) return;
            box.innerHTML = resourcesData.map((r, i) => `
                <a class="resource-item" href="${r.url}" target="_blank" rel="noopener">
                    <div class="left">
                        <span class="idx">${String(i+1).padStart(2,'0')}</span>
                        <div class="info">
                            <div class="name">${r.name}</div>
                            <div class="sub">${r.sub}</div>
                        </div>
                    </div>
                    <span class="arrow"><i class="fas fa-arrow-up-right-from-square"></i></span>
                </a>
            `).join('');
        }

        // ──────────────────────────────────────────────
        // 6. INIT
        // ──────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', () => {
            renderProjects('all');
            initFilters();
            renderCerts();
            renderResources();

            // Smooth scroll for nav links
            document.querySelectorAll('.nav-links a').forEach(link => {
                link.addEventListener('click', e => {
                    const href = link.getAttribute('href');
                    if (href && href.startsWith('#')) {
                        const target = document.querySelector(href);
                        if (target) {
                            e.preventDefault();
                            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        }
                    }
                });
            });

            // Close lightbox on Escape
            document.addEventListener('keydown', e => {
                if (e.key === 'Escape') closeLightbox();
            });
        });
    </script>
</body>
</html>
