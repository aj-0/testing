                    document.documentElement.style.setProperty('--color-text-3', '#4A6A8A');
                    document.documentElement.style.setProperty('--color-text-4', '#7A94B8');
                    document.documentElement.style.setProperty('--color-border', 'rgba(56,132,255,0.15)');
                    document.documentElement.style.setProperty('--color-border-strong', 'rgba(56,132,255,0.30)');
