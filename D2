        .project-card .media {
            width: 100%;
            height: 190px;
            background: var(--color-surface-2);
            overflow: hidden;
            cursor: pointer;
            position: relative;
        }

        .project-card .media img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            transition: transform 0.5s var(--ease-spring);
        }

        .project-card:hover .media img {
            transform: scale(1.05);
