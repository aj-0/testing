        }

        .mindset-box {
            background: var(--color-surface-2);
            border-radius: 16px;
            padding: 20px 24px;
            border-left: 4px solid var(--color-accent);
            margin-top: 16px;
        }

        .mindset-box .title {
            font-size: 0.9rem;
            font-weight: 700;
